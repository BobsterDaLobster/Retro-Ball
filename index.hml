<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>American Ball Bowl — Management Sim</title>
<style>
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#071018;color:#eef6ff;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}body{display:flex;justify-content:center}.app{width:min(1180px,100%);padding:18px}.logo{font-weight:900;font-size:clamp(25px,4vw,44px);letter-spacing:-3px;text-shadow:4px 4px #18384c}.logo b,.gold{color:#f6c84b}.sub,.muted{color:#7fa0b4}.sub{font-size:12px}header{display:flex;justify-content:space-between;align-items:end;gap:12px;margin-bottom:14px}.tabs{display:flex;gap:6px;overflow:auto;margin-bottom:14px}.tab,button{font:inherit;color:#fff;background:#183447;border:2px solid #2d5a70;border-radius:5px;padding:9px 11px;cursor:pointer;box-shadow:0 3px 0 #07131c}.tab{padding:10px 14px;color:#9db7c8}.tab.active,.tab:hover,button:hover{background:#1c3e51;color:#fff}.tab:active,button:active{transform:translateY(2px);box-shadow:0 1px 0 #07131c}.view{display:none}.view.active{display:block}.grid{display:grid;grid-template-columns:2fr 1fr;gap:14px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}.panel{background:#0d1b26;border:2px solid #1c3546;box-shadow:0 8px 0 #061019,inset 0 1px #294a5f;border-radius:8px}.card{padding:13px}.hero{padding:18px;background:linear-gradient(135deg,#102c3c,#0b1821);border:2px solid #23495d;border-radius:7px;margin-bottom:14px}.week{font-size:14px;color:#9bb7c8}.card h3{margin:0 0 7px;font-size:15px}.row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid #1b3444}.news{padding:12px;border-left:4px solid #f6c84b;background:#0a1720;margin-bottom:8px}.bar{height:9px;background:#132b3a;border:1px solid #285066;border-radius:3px;overflow:hidden}.bar i{display:block;height:100%;background:#f6c84b}.small{font-size:11px;padding:6px 8px}table{width:100%;border-collapse:collapse;font-size:12px}th,td{text-align:left;padding:8px;border-bottom:1px solid #1c3546}th{color:#6f94aa}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#0c1b25;border:2px solid #4a7891;padding:11px 15px;border-radius:5px;display:none;z-index:20}.modal{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;padding:20px;z-index:10}.modal.open{display:flex}.modalbox{width:min(720px,100%);max-height:90vh;overflow:auto;padding:18px}.modalbox h2{margin-top:0}.stat{font-size:22px;font-weight:900}.positive{color:#68d391}.negative{color:#ff7d7d}@media(max-width:800px){.grid{grid-template-columns:1fr}.app{padding:10px}}
</style>
</head>
<body>
<div class="app">
<header><div><div class="logo">AMERICAN <b>BALL</b> BOWL</div><div class="sub">FRONT OFFICE • MANAGEMENT SIM</div></div><div class="sub" id="topWeek"></div></header>
<nav class="tabs"><button class="tab active" data-view="dashboard">Dashboard</button><button class="tab" data-view="team">Roster</button><button class="tab" data-view="league">League</button><button class="tab" data-view="front">Front Office</button></nav>
<section id="dashboard" class="view active"><div class="hero"><div class="week" id="dashWeek"></div><h2 style="margin:6px 0">Run the franchise</h2><div class="muted">Games are simulated. You make the decisions that build the team.</div></div><div class="grid"><div><div class="panel card" id="teamSummary"></div><div class="panel card" style="margin-top:14px"><h3>Next Game</h3><div id="nextGame"></div><button id="simulateBtn" style="margin-top:10px">SIMULATE WEEK</button></div></div><div class="panel card"><h3>Franchise News</h3><div id="newsFeed"></div></div></div></section>
<section id="team" class="view"><div class="hero"><div class="week">ROSTER • <span id="teamTitle"></span></div><h2 style="margin:6px 0">Build your squad</h2><div class="muted">Develop players and manage your stars.</div></div><div id="roster" class="cards"></div></section>
<section id="league" class="view"><div class="hero"><div class="week">30-TEAM LEAGUE</div><h2 style="margin:6px 0">Standings & Schedule</h2><div class="muted">Regular season → playoffs → championship.</div></div><div class="grid"><div class="panel card"><h3>Standings</h3><table id="standings"></table></div><div class="panel card"><h3>Schedule</h3><div id="schedule"></div></div></div></section>
<section id="front" class="view"><div class="hero"><div class="week">FRONT OFFICE</div><h2 style="margin:6px 0">Build the franchise</h2><div class="muted">Draft, free agency, trades and coaching all affect your team.</div></div><div class="cards"><div class="panel card"><h3>Free Agency</h3><p class="muted">Find players to fill roster holes.</p><button id="faBtn">Open Free Agency</button></div><div class="panel card"><h3>Three-Round Draft</h3><p class="muted">Add young players through three rounds.</p><button id="draftBtn">Enter Draft</button><div id="draftStatus" class="muted" style="margin-top:7px"></div></div><div class="panel card"><h3>Trade Center</h3><p class="muted">Trade players for players or draft capital.</p><button id="tradeBtn">Explore Trades</button></div><div class="panel card"><h3>Coaching Staff</h3><p class="muted">Hire coaches with different specialties.</p><button id="coachBtn">Hire Coach</button></div></div></section>
</div><div id="modal" class="modal"><div id="modalBox" class="modalbox panel"></div></div><div id="toast" class="toast"></div>
<script>
(() => {
'use strict';
const $=id=>document.getElementById(id);
const teams=['Boston Minutemen','New York Empire','Philadelphia Founders','Washington Generals','Chicago Blizzards','Detroit Motors','Green Bay Packers','Minnesota Frost','Dallas Outlaws','Houston Comets','Kansas City Chiefs','Denver Peaks','Las Vegas Vipers','Los Angeles Stars','San Francisco Gold','Seattle Orcas','Arizona Scorpions','Atlanta Fire','Carolina Flight','New Orleans Gold','Tampa Bay Sharks','Miami Waves','Jacksonville Kings','Baltimore Ravens','Cincinnati Tigers','Cleveland Hounds','Pittsburgh Steel','Tennessee Titans','Indianapolis Racers','Buffalo Bulls'];
const positions=['QB','RB','WR','TE','OL','CB','EDGE'];
const skills=['Field General','Speedster','Deep Threat','Power Runner','Shutdown','Pass Rusher','Route Technician'];
const first=['Jake','Marcus','Dylan','Cameron','Tyler','Jordan','Mason','Caleb','Evan','Noah','Ryan','Logan','Aiden','Cole','Blake','Jalen','Trevor','Miles','Drew','Liam'];
const last=['Carter','Bennett','Hayes','Morgan','Brooks','Parker','Reed','Turner','Foster','Mitchell','Cooper','Walker','Collins','Murphy','Bishop','Hunter','Davis','Miller','Scott','Adams'];
let state={week:1,phase:'regular',playoffRound:0,playoffTeams:[],playoffMatchups:[],champion:null,draftRound:0,money:65,home:0,coach:{name:'Coach Riley',skill:'Clock Management',boost:2},news:['Welcome to the front office. Build a championship roster.']};
let standings=teams.map((name,i)=>({name,w:0,l:0,ovr:70+(i*7)%23}));
let rosters=teams.map((_,ti)=>Array.from({length:12},(_,i)=>makePlayer(positions[(i+ti)%positions.length],i+ti,ti)));
let faCache=[],draftCache=[];
function rint(a,b){return Math.floor(Math.random()*(b-a+1))+a}
function makePlayer(pos,seed=0,team=0){const ovr=Math.max(60,Math.min(96,67+(seed*11+team*3)%27));return{name:first[(seed+team)%first.length]+' '+last[(seed*3+team)%last.length],pos,ovr,speed:60+(seed*7+team)%37,power:60+(seed*5+team*2)%37,hands:60+(seed*9+team)%37,skill:skills[(seed+team)%skills.length],salary:Math.max(1,Math.round(ovr/12))}}
function teamRating(i){const arr=rosters[i]||[];return Math.round(arr.reduce((a,p)=>a+p.ovr,0)/Math.max(1,arr.length)+state.coach.boost)}
function toast(msg){const el=$('toast');el.textContent=msg;el.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>el.style.display='none',2200)}
function modal(title,body){$('modalBox').innerHTML='<h2>'+title+'</h2>'+body+'<div style="text-align:right;margin-top:14px"><button id="closeModal">CLOSE</button></div>';$('modal').classList.add('open');$('closeModal').onclick=closeModal}
function closeModal(){$('modal').classList.remove('open')}
function phaseLabel(){if(state.phase==='regular')return `WEEK ${state.week} OF 18`;if(state.phase==='playoffs')return ['WILDCARD ROUND','SEMIFINALS','CHAMPIONSHIP'][state.playoffRound-1]||'PLAYOFFS';return state.phase==='offseason'?'OFFSEASON':'DRAFT'}
function renderDashboard(){const t=teams[state.home];let opponentText='';if(state.phase==='regular'){const opp=(state.home+state.week+3)%30;opponentText=`<div class="row"><span>${t}</span><b>vs ${teams[opp]}</b></div><div class="muted" style="margin-top:8px">Your rating: ${teamRating(state.home)} • Opponent: ${teamRating(opp)}</div>`}else if(state.phase==='playoffs'){const match=state.playoffMatchups.find(m=>m.includes(state.home));opponentText=`<div class="news"><b>PLAYOFFS</b><br>${match?match.map(i=>teams[i]).join(' vs '):'Your team is awaiting the next round.'}</div><div class="muted">Finish the playoff bracket to reach the draft.</div>`}else if(state.phase==='offseason'){opponentText=`<div class="news"><b>SEASON COMPLETE</b><br>${state.champion!==null?teams[state.champion]+' are champions.':''}</div><div class="muted">The offseason is over when you enter the draft.</div>`}else{opponentText=`<div class="news"><b>DRAFT DAY</b><br>Three rounds. Build next season's roster.</div>`}$('topWeek').textContent=`${phaseLabel()} • $${state.money}M BUDGET`;$('dashWeek').textContent=`${phaseLabel()} • ${standings[state.home].w}-${standings[state.home].l}`;$('teamSummary').innerHTML=`<h3>${t}</h3><div class="grid" style="grid-template-columns:repeat(3,1fr);gap:8px"><div><span class="muted">TEAM OVR</span><br><b class="gold stat">${teamRating(state.home)}</b></div><div><span class="muted">RECORD</span><br><b class="stat">${standings[state.home].w}-${standings[state.home].l}</b></div><div><span class="muted">COACH</span><br><b>${state.coach.name}</b></div></div><p class="muted">${state.coach.skill} • +${state.coach.boost} team impact</p>`;$('nextGame').innerHTML=opponentText;$('simulateBtn').textContent=state.phase==='regular'?'SIMULATE WEEK':state.phase==='playoffs'?'SIMULATE PLAYOFF GAME':state.phase==='offseason'?'ENTER DRAFT':'DRAFT IN PROGRESS';$('simulateBtn').disabled=state.phase==='draft';$('newsFeed').innerHTML=state.news.slice(-7).reverse().map(n=>`<div class="news">${n}</div>`).join('')}
function renderRoster(){$('teamTitle').textContent=teams[state.home];$('roster').innerHTML=rosters[state.home].map((p,i)=>`<div class="panel card"><h3>${p.name} <span class="gold">${p.ovr}</span></h3><div class="muted">${p.pos} • ${p.skill}</div><p>SPD ${p.speed} • POW ${p.power} • HND ${p.hands}</p><div class="bar"><i style="width:${p.ovr}%"></i></div><p class="muted">$${p.salary}M / yr</p><button class="small" data-upgrade="${i}">Develop +1 OVR ($2M)</button></div>`).join('')}
function renderLeague(){const sorted=[...standings].sort((a,b)=>b.w-a.w||a.l-b.l||b.ovr-a.ovr);$('standings').innerHTML='<tr><th>#</th><th>TEAM</th><th>OVR</th><th>W</th><th>L</th></tr>'+sorted.map((t,i)=>`<tr><td>${i+1}</td><td>${t.name}</td><td>${t.ovr}</td><td>${t.w}</td><td>${t.l}</td></tr>`).join('');if(state.phase==='playoffs')$('schedule').innerHTML=`<div class="news"><b>${phaseLabel()}</b></div>`+state.playoffMatchups.map(m=>`<div class="row"><span>${teams[m[0]]}</span><b>vs ${teams[m[1]]}</b></div>`).join('');else $('schedule').innerHTML=teams.slice(0,15).map((t,i)=>`<div class="row"><span>W${Math.min(18,state.week)} • ${t}</span><b>${i%2?'@':'vs'} ${teams[(i+5)%30]}</b></div>`).join('')}
function simulateWeek(){if(state.phase==='regular'){simulateRegularWeek();return}if(state.phase==='playoffs'){simulatePlayoffGame();return}if(state.phase==='offseason'){enterDraft();return}toast('Draft is already in progress.');}
function simulateRegularWeek(){const opp=(state.home+state.week+3)%30,a=teamRating(state.home),b=teamRating(opp),diff=a-b,base=17,me=Math.max(3,Math.round(base+diff/3+rint(-7,7))),them=Math.max(3,Math.round(base-diff/3+rint(-7,7)));if(me===them){standings[state.home].w++;standings[opp].w++}else if(me>them){standings[state.home].w++;standings[opp].l++}else{standings[state.home].l++;standings[opp].w++}for(let i=0;i<30;i++){if(i!==state.home&&i!==opp&&Math.random()<.6){if(Math.random()<.5)standings[i].w++;else standings[i].l++}}state.news.push(`${teams[state.home]} ${me}, ${teams[opp]} ${them} — Week ${state.week} simulated.`);state.week++;if(state.week>18)startPlayoffs();renderAll();toast(state.phase==='playoffs'?'REGULAR SEASON COMPLETE • PLAYOFFS START':'WEEK COMPLETE')}
function startPlayoffs(){const top=[...standings.map((t,i)=>({...t,i}))].sort((a,b)=>b.w-a.w||b.ovr-a.ovr).slice(0,8).map(t=>t.i);state.phase='playoffs';state.playoffRound=1;state.playoffTeams=top;state.playoffMatchups=[[top[0],top[7]],[top[1],top[6]],[top[2],top[5]],[top[3],top[4]]];state.news.push('The 18-week regular season is over. The top 8 teams made the playoffs.');}
function simulatePlayoffGame(){if(!state.playoffMatchups.length){return}const match=state.playoffMatchups[0];const a=match[0],b=match[1];const ra=teamRating(a),rb=teamRating(b);const winner=ra+ rint(-10,10)>=rb+rint(-10,10)?a:b;const loser=winner===a?b:a;state.news.push(`${teams[winner]} defeated ${teams[loser]} in the ${phaseLabel().toLowerCase()}.`);state.playoffMatchups.shift();state.playoffTeams=state.playoffTeams.filter(i=>i!==loser);if(state.playoffMatchups.length===0){if(state.playoffRound===1){state.playoffRound=2;const q=[...state.playoffTeams];state.playoffMatchups=[[q[0],q[1]],[q[2],q[3]]]}else if(state.playoffRound===2){state.playoffRound=3;const q=[...state.playoffTeams];state.playoffMatchups=[[q[0],q[1]]]}else{state.champion=winner;state.phase='offseason';state.playoffRound=0;state.news.push(`${teams[winner]} won the championship! Enter the draft to begin the next season.`)}}renderAll();toast(state.phase==='offseason'?'CHAMPIONSHIP COMPLETE':'PLAYOFF GAME COMPLETE')}
function enterDraft(){if(state.phase!=='offseason'){toast('The draft is only available after the playoffs.');return}state.phase='draft';state.draftRound=0;draft();renderAll()}
function upgrade(i){if(state.money<2){toast('Not enough budget.');return}const p=rosters[state.home][i];p.ovr=Math.min(99,p.ovr+1);p.speed=Math.min(99,p.speed+1);state.money-=2;state.news.push(`${p.name} improved to ${p.ovr} OVR.`);renderAll();toast(`${p.name} developed +1 OVR`)}
function freeAgency(){faCache=Array.from({length:6},(_,i)=>makePlayer(positions[rint(0,6)],i+8,state.home));modal('FREE AGENCY',faCache.map((p,i)=>`<div class="row"><div><b>${p.name}</b> <span class="gold">${p.ovr}</span><br><span class="muted">${p.pos} • ${p.skill} • $${p.salary}M</span></div><button data-sign="${i}">SIGN</button></div>`).join(''));document.querySelectorAll('[data-sign]').forEach(b=>b.onclick=()=>signFA(+b.dataset.sign))}
function signFA(i){const p=faCache[i];if(!p)return;if(state.money<p.salary){toast('Not enough budget.');return}state.money-=p.salary;rosters[state.home].push(p);state.news.push(`${p.name} signed in free agency.`);closeModal();renderAll();toast('Free agent signed.')}
function draft(){if(state.phase!=='draft'){toast('Draft opens only after the 18-week season and playoffs.');return}if(state.draftRound>=3){return}const round=state.draftRound+1;const p=makePlayer(positions[rint(0,6)],round+18+state.home,state.home);draftCache=[p];modal(`THREE-ROUND DRAFT • ROUND ${round}`,`<div class="row"><div><b>${p.name}</b> <span class="gold">${p.ovr}</span><br><span class="muted">${p.pos} • ${p.skill} • SPD ${p.speed} • HND ${p.hands}</span></div><button data-pick="0">DRAFT PLAYER</button></div>`);document.querySelectorAll('[data-pick]').forEach(b=>b.onclick=()=>draftPick(0))}
function draftPick(i){const p=draftCache[i];if(!p)return;rosters[state.home].push(p);state.news.push(`Drafted ${p.name} (${p.ovr} OVR) in Round ${state.draftRound+1}.`);state.draftRound++;draftCache=[];closeModal();if(state.draftRound>=3){state.phase='regular';state.week=1;state.playoffTeams=[];state.playoffMatchups=[];state.champion=null;state.draftRound=0;standings=standings.map(t=>({...t,w:0,l:0}));state.news.push('Draft complete. A new 18-week season begins.');renderAll();toast('DRAFT COMPLETE • NEW SEASON')}else{renderAll();setTimeout(draft,120);toast(`ROUND ${state.draftRound} COMPLETE`)}}
function trade(){const target=(state.home+2)%30;const p=rosters[target][0];modal('TRADE CENTER',`<div class="news">${teams[target]} are listening on <b>${p.name}</b> (${p.pos}, ${p.ovr} OVR).</div><div class="row"><span>Offer your 2nd-round pick</span><button id="tradeOffer">OFFER</button></div>`);$('tradeOffer').onclick=()=>{rosters[state.home].push({...p,salary:p.salary});rosters[target].shift();state.news.push(`Trade completed with ${teams[target]} for ${p.name}.`);closeModal();renderAll();toast('Trade completed.')}}
function hireCoach(){const coaches=[['Coach Riley','Clock Management',3],['Coach Vega','Route Precision',4],['Coach Knox','Run Blocking',4],['Coach Stone','Turnover Defense',3]];modal('COACHING MARKET',coaches.map((c,i)=>`<div class="row"><div><b>${c[0]}</b><br><span class="muted">${c[1]} • +${c[2]} impact</span></div><button data-coach="${i}">HIRE ($5M)</button></div>`).join(''));document.querySelectorAll('[data-coach]').forEach(b=>b.onclick=()=>{const c=coaches[+b.dataset.coach];if(state.money<5){toast('Not enough budget.');return}state.money-=5;state.coach={name:c[0],skill:c[1],boost:c[2]};state.news.push(`${c[0]} hired as head coach.`);closeModal();renderAll();toast('Coach hired.')})}
function renderAll(){renderDashboard();renderRoster();renderLeague();const canDraft=state.phase==='offseason'||state.phase==='draft';$('draftBtn').disabled=!canDraft;$('draftBtn').textContent=state.phase==='draft'?'DRAFT IN PROGRESS':'Enter Draft';$('draftStatus').textContent=state.phase==='regular'?'Locked until after Week 18 + playoffs.':state.phase==='playoffs'?'Locked until the championship is finished.':state.phase==='offseason'?'Season complete — enter the draft to begin the next offseason.':'Draft is open.'}
document.querySelectorAll('.tab').forEach(tab=>tab.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));tab.classList.add('active');$(tab.dataset.view).classList.add('active')}));
$('simulateBtn').onclick=simulateWeek;$('faBtn').onclick=freeAgency;$('draftBtn').onclick=()=>state.phase==='offseason'?enterDraft():draft();$('tradeBtn').onclick=trade;$('coachBtn').onclick=hireCoach;
$('roster').addEventListener('click',e=>{const b=e.target.closest('[data-upgrade]');if(b)upgrade(+b.dataset.upgrade)});$('modal').addEventListener('click',e=>{if(e.target.id==='modal')closeModal()});
renderAll();
})();
</script>
</body></html>
