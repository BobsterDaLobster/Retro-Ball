<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>American Ball Bowl</title>
<style>
*{box-sizing:border-box}html,body{margin:0;background:#071018;color:#eef6ff;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;min-height:100%}
body{display:flex;justify-content:center}.app{width:min(1180px,100%);padding:18px}
header{display:flex;justify-content:space-between;align-items:end;gap:12px;margin-bottom:14px}
.logo{font-weight:900;font-size:clamp(25px,4vw,44px);letter-spacing:-3px;text-shadow:4px 4px #18384c}
.logo b{color:#f6c84b}.sub{color:#7fa0b4;font-size:12px}
.panel{background:#0d1b26;border:2px solid #1c3546;box-shadow:0 8px 0 #061019, inset 0 1px #294a5f;border-radius:8px}
.tabs{display:flex;gap:6px;overflow:auto;margin-bottom:14px}
.tab{background:#102534;color:#9db7c8;border:2px solid #1b3a4d;padding:10px 14px;font:inherit;cursor:pointer;border-radius:5px}
.tab.active,.tab:hover{background:#1c3e51;color:#fff;border-color:#3c718b}
.view{display:none}.view.active{display:block}
.grid{display:grid;grid-template-columns:2fr 1fr;gap:14px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}
.card{padding:13px}.card h3{margin:0 0 7px;font-size:15px}
.muted{color:#7895a7}.gold{color:#f6c84b}.green{color:#68d391}.red{color:#ff7d7d}.cyan{color:#63d8ff}
button{font:inherit;color:#fff;background:#183447;border:2px solid #2d5a70;border-radius:5px;padding:9px 11px;cursor:pointer;box-shadow:0 3px 0 #07131c}
button:hover{filter:brightness(1.18)}button:active{transform:translateY(2px);box-shadow:0 1px 0 #07131c}
.danger{border-color:#79404a}.small{font-size:11px;padding:6px 8px}
.score{display:flex;justify-content:space-between;align-items:center;padding:15px 18px;background:#09151e;border-bottom:2px solid #203c4e}
.score big{font-size:25px;font-weight:900}.score .clock{color:#f6c84b}
.game-layout{display:grid;grid-template-columns:1fr 280px;gap:14px;margin-top:14px}
#field{width:100%;display:block;image-rendering:pixelated;background:#3a8d4c;border:4px solid #1a3428;border-radius:5px}
.controls{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}
.controls button{min-height:48px}
.play-card{padding:12px;margin-bottom:10px}.play-card h3{margin:0 0 8px}
.route{display:flex;gap:7px;flex-wrap:wrap}.route button{flex:1;min-width:70px}
table{width:100%;border-collapse:collapse;font-size:12px}
th,td{text-align:left;padding:8px;border-bottom:1px solid #1c3546}th{color:#6f94aa}
.bar{height:9px;background:#132b3a;border:1px solid #285066;border-radius:3px;overflow:hidden}
.bar i{display:block;height:100%;background:#f6c84b}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#0c1b25;border:2px solid #4a7891;padding:11px 15px;border-radius:5px;display:none;z-index:20}
.modal{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;padding:20px;z-index:10}
.modal.open{display:flex}
.modalbox{width:min(720px,100%);max-height:90vh;overflow:auto;padding:18px}
.modalbox h2{margin-top:0}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid #1b3444}
.news{padding:12px;border-left:4px solid #f6c84b;background:#0a1720}
.week{font-size:14px;color:#9bb7c8}
.hero{padding:18px;background:linear-gradient(135deg,#102c3c,#0b1821);border:2px solid #23495d;border-radius:7px;margin-bottom:14px}
@media(max-width:800px){
  .grid,.game-layout{grid-template-columns:1fr}
  .app{padding:10px}
  .game-layout{display:block}
  .side{margin-top:12px}
}
</style>
</head>

<body>
<div class="app">

<header>
  <div>
    <div class="logo">AMERICAN <b>BALL</b> BOWL</div>
    <div class="sub">PIXEL FOOTBALL • OFFENSE ONLY • LEAGUE SIM</div>
  </div>
  <div id="record" class="sub"></div>
</header>

<div class="tabs">
  <button class="tab active" data-view="game">GAME</button>
  <button class="tab" data-view="team">TEAM</button>
  <button class="tab" data-view="league">LEAGUE</button>
  <button class="tab" data-view="front">FRONT OFFICE</button>
</div>

<section id="game" class="view active">
  <div class="panel">

    <div class="score">
      <div>
        <b id="homeName">Boston Minutemen</b><br>
        <span class="muted">HOME</span>
      </div>

      <big id="scoreTxt">0 — 0</big>

      <div style="text-align:right">
        <b id="awayName">Miami Waves</b><br>
        <span class="muted">AWAY</span>
      </div>
    </div>

    <div style="padding:10px 14px;display:flex;justify-content:space-between">
      <span id="driveTxt">Opening kickoff</span>
      <span class="clock" id="clock">Q1 5:00</span>
    </div>

    <canvas id="field" width="900" height="420"></canvas>

  </div>

  <div class="game-layout">

    <div class="panel" style="padding:12px">

      <div class="play-card">
        <h3 id="playTitle">Choose a play</h3>

        <div class="route">
          <button onclick="choosePlay('slant')">SLANT</button>
          <button onclick="choosePlay('post')">POST</button>
          <button onclick="choosePlay('out')">OUT</button>
          <button onclick="choosePlay('run')">RUN</button>
          <button onclick="choosePlay('screen')">SCREEN</button>
        </div>
      </div>

      <div class="play-card">
        <h3>Quarterback</h3>

        <div class="muted">
          Tap a receiver route to throw.
          Tap the running back to hand off.
        </div>

        <div class="controls">
          <button onclick="throwBall(0)">A</button>
          <button onclick="throwBall(1)">B</button>
          <button onclick="throwBall(2)">C</button>
        </div>
      </div>

      <div class="play-card">
        <h3>Game events</h3>
        <div id="log" class="muted">
          Your season starts now. Win the drive.
        </div>
      </div>

    </div>

    <div class="side">

      <div class="panel card">
        <h3>Drive</h3>
        <div id="down">1st & 10</div>

        <div class="bar">
          <i id="fieldBar" style="width:12%"></i>
        </div>

        <p class="muted">Field position</p>

        <button onclick="simDefense()">
          SIMULATE DEFENSE
        </button>

        <button onclick="onside()" class="small">
          ATTEMPT ONSIDE KICK
        </button>
      </div>

      <div class="panel card">
        <h3>Star Power</h3>
        <div id="stars"></div>
      </div>

    </div>

  </div>
</section>

<section id="team" class="view">

  <div class="hero">
    <div class="week">
      ROSTER • <span id="teamTitle"></span>
    </div>

    <h2 style="margin:6px 0">
      Build your squad
    </h2>

    <div class="muted">
      Up to 10 named stars per team.
      Attributes affect plays, contracts, and trade value.
    </div>
  </div>

  <div id="roster" class="cards"></div>

</section>

<section id="league" class="view">

  <div class="hero">
    <div class="week">
      30-TEAM LEAGUE
    </div>

    <h2 style="margin:6px 0">
      Standings & schedule
    </h2>

    <div class="muted">
      Regular season → playoffs → American Ball Bowl championship.
    </div>
  </div>

  <div class="grid">

    <div class="panel card">
      <h3>Standings</h3>
      <table id="standings"></table>
    </div>

    <div class="panel card">
      <h3>Schedule</h3>
      <div id="schedule"></div>
    </div>

  </div>

</section>

<section id="front" class="view">

  <div class="hero">
    <div class="week">
      FRONT OFFICE
    </div>

    <h2 style="margin:6px 0">
      Build the franchise
    </h2>

    <div class="muted">
      Three-round draft, free agency,
      trades, and coaching hires.
    </div>
  </div>

  <div class="cards">

    <div class="panel card">
      <h3>Free Agency</h3>
      <p class="muted">
        Available players refresh between seasons.
      </p>
      <button onclick="freeAgency()">
        Open free agency
      </button>
    </div>

    <div class="panel card">
      <h3>Three-Round Draft</h3>
      <p class="muted">
        Use picks to add young stars.
      </p>
      <button onclick="draft()">
        Enter draft
      </button>
    </div>

    <div class="panel card">
      <h3>Trade Center</h3>
      <p class="muted">
        Trade players or picks with the league.
      </p>
      <button onclick="trade()">
        Explore trades
      </button>
    </div>

    <div class="panel card">
      <h3>Coaching Staff</h3>
      <p class="muted">
        Coaches have specialties that affect your team.
      </p>
      <button onclick="hireCoach()">
        Hire a coach
      </button>
    </div>

  </div>

</section>

</div>

<div id="modal" class="modal">
  <div class="modalbox panel" id="modalBox"></div>
</div>

<div id="toast" class="toast"></div>

<script>

const teams = [
  "Boston Minutemen",
  "New York Empire",
  "Philadelphia Founders",
  "Washington Sentinels",
  "Miami Waves",
  "Atlanta Firebirds",
  "Charlotte Crowns",
  "Nashville Kings",
  "New Orleans Voodoo",
  "Tampa Bay Tridents",
  "Chicago Hounds",
  "Detroit Motors",
  "Green Bay Frost",
  "Minnesota Northstars",
  "Cleveland Forge",
  "Cincinnati Rivermen",
  "Pittsburgh Steel",
  "Baltimore Admirals",
  "Indianapolis Racers",
  "Houston Comets",
  "Dallas Outlaws",
  "Kansas City Barons",
  "Denver Peaks",
  "Arizona Scorpions",
  "Las Vegas Aces",
  "Los Angeles Stars",
  "San Francisco Gold",
  "Seattle Orcas",
  "Portland Pioneers",
  "Salt Lake Peaks"
];

const first = [
  "Marcus","Jalen","Ty","Darius",
  "Evan","Caleb","Noah","Andre",
  "Malik","Jordan","Trey","Cameron",
  "Miles","Devin","Isaiah","Cole"
];

const last = [
  "Carter","Reed","Hayes","Brooks",
  "Grant","Morris","Stone","Bennett",
  "Parker","Davis","Knight","Turner",
  "Young","Price","Foster","Banks"
];

const positions = [
  "QB","RB","WR","WR","TE","WR",
  "OL","OL","EDGE","CB"
];

let rng = 42;

function rand(){
  rng = (rng * 1664525 + 1013904223) >>> 0;
  return rng / 4294967296;
}

function rint(a,b){
  return Math.floor(rand() * (b-a+1)) + a;
}

function player(pos,i){
  return {
    name:
      first[rint(0,first.length-1)] +
      " " +
      last[rint(0,last.length-1)],

    pos,

    ovr:rint(58,91),
    speed:rint(55,96),
    power:rint(50,95),
    hands:rint(55,96),
    salary:rint(2,18),

    skill:[
      "Clutch",
      "Deep Threat",
      "Elusive",
      "Field General",
      "Route Artist"
    ][rint(0,4)]
  };
}

let rosters = teams.map((t,ti) =>
  Array.from(
    {length:rint(5,10)},
    (_,i) => player(positions[i],i)
  )
);

let standings = teams.map((name,i) => ({
  name,
  w:rint(0,2),
  l:rint(0,2),
  pts:0,
  seed:i
}));

let state = {
  week:1,
  q:1,
  time:300,

  home:0,
  away:4,

  homeScore:0,
  awayScore:0,

  down:1,
  yd:10,
  ball:12,

  pos:0,
  drive:0,
  plays:0,

  coach:{
    name:"Coach Riley",
    skill:"Clock Management",
    boost:3
  },

  coins:65
};

const $ = id =>
  document.getElementById(id);

function toast(s){
  $("toast").textContent = s;
  $("toast").style.display = "block";

  setTimeout(() => {
    $("toast").style.display = "none";
  },1800);
}

function save(){
  localStorage.setItem(
    "abb_save",
    JSON.stringify({
      rosters,
      standings,
      state
    })
  );
}

function load(){
  try{
    let x = JSON.parse(
      localStorage.getItem("abb_save")
    );

    if(x){
      rosters = x.rosters;
      standings = x.standings;
      state = x.state;
    }

  }catch(e){}
}

load();

document.querySelectorAll(".tab").forEach(b => {

  b.onclick = () => {

    document
      .querySelectorAll(".tab")
      .forEach(x =>
        x.classList.remove("active")
      );

    b.classList.add("active");

    document
      .querySelectorAll(".view")
      .forEach(x =>
        x.classList.remove("active")
      );

    $(b.dataset.view)
      .classList.add("active");

    if(b.dataset.view === "team")
      renderRoster();

    if(b.dataset.view === "league")
      renderLeague();

    if(b.dataset.view === "game")
      draw();
  };

});

function init(){
  render();
  draw();

  setInterval(() => {

    if(state.plays > 0){

      state.time =
        Math.max(0,state.time-1);

      if(state.time === 0)
        endQuarter();
    }

    render();

  },1000);
}

function render(){

  let h = teams[state.home];
  let a = teams[state.away];

  $("homeName").textContent = h;
  $("awayName").textContent = a;

  $("scoreTxt").textContent =
    state.homeScore +
    " — " +
    state.awayScore;

  $("clock").textContent =
    `Q${state.q} ${
      String(Math.floor(state.time/60))
        .padStart(2,"0")
    }:${
      String(state.time%60)
        .padStart(2,"0")
    }`;

  $("driveTxt").textContent =
    state.pos === 0
      ? "Your offense"
      : "Opponent offense";

  $("down").textContent =
    `${["","1st","2nd","3rd","4th"][state.down]}
     & ${state.yd}`;

  $("fieldBar").style.width =
    Math.max(
      5,
      Math.min(95,state.ball)
    ) + "%";

  $("teamTitle").textContent = h;

  $("record").textContent =
    `Week ${state.week} • $${state.coins}M cap space`;

  let stars =
    rosters[state.home].slice(0,10);

  $("stars").innerHTML =
    stars.map(p => `
      <div style="margin:7px 0">
        <b>${p.name}</b>
        <span class="gold">${p.ovr}</span>
        <br>
        <span class="muted">
          ${p.pos} • ${p.skill}
        </span>
      </div>
    `).join("");
}

function renderRoster(){

  let arr =
    rosters[state.home];

  $("roster").innerHTML =
    arr.map((p,i) => `

      <div class="panel card">

        <h3>
          ${p.name}
          <span class="gold">
            ${p.ovr}
          </span>
        </h3>

        <div class="muted">
          ${p.pos} • ${p.skill}
        </div>

        <p>
          SPD ${p.speed} •
          POW ${p.power} •
          HND ${p.hands}
        </p>

        <div class="bar">
          <i style="width:${p.ovr}%"></i>
        </div>

        <p class="muted">
          $${p.salary}M / yr
        </p>

        <button
          class="small"
          onclick="upgrade(${i})"
        >
          Develop
        </button>

      </div>

    `).join("");
}

function renderLeague(){

  let sorted =
    [...standings]
    .sort((a,b) =>
      b.w-a.w ||
      a.l-b.l
    );

  $("standings").innerHTML =
    "<tr>" +
    "<th>#</th>" +
    "<th>TEAM</th>" +
    "<th>W</th>" +
    "<th>L</th>" +
    "</tr>" +

    sorted.map((t,i) => `
      <tr>
        <td>${i+1}</td>
        <td>${t.name}</td>
        <td>${t.w}</td>
        <td>${t.l}</td>
      </tr>
    `).join("");

  $("schedule").innerHTML =
    teams.slice(0,12)
      .map((t,i) => `

        <div class="row">

          <span>
            W${Math.min(18,state.week)}
            • ${t}
          </span>

          <b>
            ${i%2 ? "@" : "vs"}
            ${teams[(i+5)%30]}
          </b>

        </div>

      `).join("");
}

function log(s){

  $("log").innerHTML =
    `<span class="cyan">▶</span> ${s}`;

  render();
  save();
}

function choosePlay(type){

  let names = {
    slant:"SLANT • quick separation",
    post:"POST • attack deep middle",
    out:"OUT • sideline route",
    run:"RUN • handoff to RB",
    screen:"SCREEN • RB in space"
  };

  $("playTitle").textContent =
    names[type];

  if(type === "run"){
    runBall();
    return;
  }

  draw(type);

  toast(
    "Play set: " +
    type.toUpperCase()
  );
}

function runBall(){

  let rb =
    rosters[state.home]
      .find(p => p.pos === "RB") ||
    rosters[state.home][0];

  let gain =
    rint(2,9) +
    Math.floor((rb.speed-65)/15) +
    (rb.skill === "Elusive" ? 3 : 0);

  state.ball += gain;
  state.yd -= gain;
  state.plays++;

  log(
    `${rb.name} hits the crease for ${gain} yards.`
  );

  advanceDown(gain);
}

function throwBall(n){

  let arr =
    rosters[state.home]
      .filter(p =>
        ["WR","TE"].includes(p.pos)
      );

  let p =
    arr[n % arr.length] ||
    rosters[state.home][0];

  let chance =
    Math.min(
      .9,
      .48 +
      (p.hands-65)/150 +
      (p.speed-70)/250 +
      (
        state.coach.skill ===
        "Route Precision"
        ? .04
        : 0
      )
    );

  let roll = rand();

  state.plays++;

  if(roll < chance){

    let gain =
      rint(5,18) +
      Math.floor((p.speed-70)/12);

    state.ball += gain;
    state.yd -= gain;

    log(
      `${p.name} makes the catch for ${gain} yards.`
    );

    advanceDown(gain);

  }else{

    if(roll < chance + .11){

      log(
        `${p.name} can't secure it. Incomplete pass.`
      );

      state.down++;

      state.yd =
        state.down === 4
          ? 10
          : state.yd;

    }else{

      log(
        `INTERCEPTION! ${p.name}'s route was jumped.`
      );

      turnover();
    }
  }
}

function advanceDown(g){

  if(state.ball >= 100){

    state.homeScore += 7;

    log(
      "TOUCHDOWN! Six points plus the kick."
    );

    kickoff();

    return;
  }

  if(state.yd <= 0){

    state.down = 1;
    state.yd = 10;

    log(
      "FIRST DOWN! Keep the drive alive."
    );

    return;
  }

  state.down++;

  if(state.down === 4){

    log(
      "Fourth down. The defense gets the ball."
    );

    turnover();

    return;
  }

  state.yd =
    Math.max(1,state.yd);
}

function turnover(){

  state.pos = 1;
  state.down = 1;
  state.yd = 10;
  state.ball = 88;

  setTimeout(
    simDefense,
    400
  );

  render();
}

function simDefense(){

  let opp =
    teams[state.away];

  if(rand() < .12){

    state.awayScore += 7;

    log(
      `${opp} finishes its simulated possession with a touchdown.`
    );

  }else if(rand() < .25){

    state.awayScore += 3;

    log(
      `${opp} kicks a field goal during the simulated possession.`
    );

  }else{

    log(
      `${opp} goes three-and-out. Your defense holds.`
    );
  }

  state.pos = 0;
  state.ball = 12;
  state.down = 1;
  state.yd = 10;
  state.drive++;

  render();
  save();
}

function kickoff(){

  state.pos = 0;
  state.ball = 12;
  state.down = 1;
  state.yd = 10;
  state.drive++;

  if(rand() < .08){

    log(
      "Kickoff return! Your return unit breaks one for 32 yards."
    );

  }else{

    log(
      "Kickoff returned to the 12-yard line."
    );
  }

  render();
  save();
}

function onside(){

  if(
    state.homeScore < state.awayScore &&
    rand() < .42
  ){

    state.pos = 0;
    state.ball = 45;
    state.down = 1;
    state.yd = 10;

    log(
      "ONSIDE KICK RECOVERED! You keep possession."
    );

  }else{

    state.pos = 1;

    log(
      "The opponent recovers the onside kick."
    );

    simDefense();
  }
}

function endQuarter(){

  if(state.q < 4){

    state.q++;
    state.time = 300;

    log(
      `End of quarter. Welcome to Q${state.q}.`
    );

  }else{

    endGame();
  }
}

function endGame(){

  let hs = state.homeScore;
  let as = state.awayScore;

  let h = standings[state.home];
  let a = standings[state.away];

  if(hs > as){

    h.w++;
    a.l++;

  }else if(as > hs){

    a.w++;
    h.l++;

  }else{

    h.w++;
    a.w++;
  }

  if(state.week < 18){

    state.week++;

    state.q = 1;
    state.time = 300;

    state.homeScore = 0;
    state.awayScore = 0;

    state.away =
      (state.away + 1) % 30;

    state.ball = 12;
    state.down = 1;
    state.yd = 10;

    log(
      `FINAL ${hs}-${as}. New week: ${state.week}.`
    );

  }else{

    log(
      `SEASON COMPLETE: ${hs}-${as}. Playoff bracket unlocked.`
    );
  }

  save();
  render();
}

function upgrade(i){

  if(state.coins < 8){

    toast(
      "Need $8M development budget."
    );

    return;
  }

  state.coins -= 8;

  let p =
    rosters[state.home][i];

  p.ovr =
    Math.min(
      99,
      p.ovr + rint(1,4)
    );

  p.speed =
    Math.min(
      99,
      p.speed + rint(0,2)
    );

  toast(
    `${p.name} developed to ${p.ovr} OVR`
  );

  renderRoster();
  render();
  save();
}

function modal(title,body){

  $("modalBox").innerHTML =
    `<h2>${title}</h2>
     ${body}
     <p>
       <button onclick="closeModal()">
         CLOSE
       </button>
     </p>`;

  $("modal").classList.add("open");
}

function closeModal(){

  $("modal")
    .classList.remove("open");
}

let faCache = [];

