function draw(play=""){

  let c =
    $("field");

  let x =
    c.getContext("2d");

  let w =
    c.width;

  let h =
    c.height;

  x.clearRect(
    0,0,w,h
  );

  x.fillStyle =
    "#3a8d4c";

  x.fillRect(
    0,0,w,h
  );

  x.fillStyle =
    "#d8efd1";

  for(let i=0;i<=10;i++){

    let xx =
      i*w/10;

    x.fillRect(
      xx,
      0,
      2,
      h
    );

    x.font =
      "16px monospace";

    x.fillText(
      i*10,
      xx+5,
      24
    );
  }

  x.fillStyle =
    "#bfe5bd";

  for(
    let y=55;
    y<h;
    y+=55
  ){

    x.fillRect(
      0,
      y,
      w,
      2
    );
  }

  let scr =
    play || "run";

  let routes =
    scr === "post"
      ? [
          [210,130,340,70,520,100],
          [220,210,400,210,570,90],
          [210,300,350,320,600,320]
        ]

      : scr === "out"
      ? [
          [210,130,350,100,440,55],
          [220,210,360,210,430,150],
          [210,300,360,300,430,360]
        ]

      : scr === "slant"
      ? [
          [210,130,340,110,470,55],
          [220,210,350,180,500,120],
          [210,300,330,270,460,300]
        ]

      : [
          [210,130,350,130,520,130],
          [220,210,370,210,550,210],
          [210,300,350,300,510,300]
        ];

  x.lineWidth = 5;
  x.strokeStyle = "#fff";

  routes.forEach(r => {

    x.beginPath();

    x.moveTo(
      r[0],
      r[1]
    );

    x.lineTo(
      r[2],
      r[3]
    );

    x.lineTo(
      r[4],
      r[5]
    );

    x.stroke();
  });

  let players = [
    [130,130,"QB"],
    [180,210,"RB"],
    [130,300,"C"],
    [210,130,"A"],
    [220,210,"B"],
    [210,300,"C"]
  ];

  players.forEach((p,i) => {

    x.fillStyle =
      i < 3
        ? "#e84c4c"
        : "#f6c84b";

    x.fillRect(
      p[0]-10,
      p[1]-10,
      20,
      20
    );

    x.fillStyle =
      "#071018";

    x.font =
      "bold 12px monospace";

    x.fillText(
      p[2],
      p[0]-4,
      p[1]+4
    );
  });

  x.fillStyle =
    "#fff";

  x.font =
    "bold 15px monospace";

  x.fillText(
    "TAP RB TO RUN • TAP ROUTE TO THROW",
    20,
    400
  );
}

$("field").addEventListener(
  "click",
  e => {

    let r =
      $("field").getBoundingClientRect();

    let x =
      (e.clientX-r.left) *
      900 /
      r.width;

    let y =
      (e.clientY-r.top) *
      420 /
      r.height;

    if(
      x > 145 &&
      x < 215 &&
      y > 170 &&
      y < 250
    ){

      runBall();

    }else if(
      x > 190 &&
      y < 170
    ){

      throwBall(0);

    }else if(
      x > 190 &&
      y < 260
    ){

      throwBall(1);

    }else if(
      x > 190
    ){

      throwBall(2);
    }
  }
);

init();

</script>
